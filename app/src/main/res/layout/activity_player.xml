<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="#000">
    <androidx.media3.ui.PlayerView android:id="@+id/playerView" android:layout_width="match_parent"
        android:layout_height="match_parent" app:use_controller="false"
        xmlns:app="http://schemas.android.com/apk/res-auto"/>
    <TextView android:id="@+id/title" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_margin="24dp" android:textColor="#FFF" android:textSize="22sp" android:background="#88000000" android:padding="8dp"/>
    <ListView android:id="@+id/overlayList" android:layout_width="360dp" android:layout_height="match_parent"
        android:background="#CC000000" android:visibility="gone"/>
</FrameLayout>
