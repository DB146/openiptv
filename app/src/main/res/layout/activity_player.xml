<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="#000">
    <SurfaceView android:id="@+id/surface" android:layout_width="match_parent" android:layout_height="match_parent"/>
    <TextView android:id="@+id/title" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_margin="24dp" android:padding="8dp" android:textColor="#FFF" android:textSize="22sp"
        android:background="#88000000" android:visibility="gone"/>
    <TextView android:id="@+id/entry" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="top|end" android:layout_margin="24dp" android:padding="8dp" android:textColor="#FFF"
        android:textSize="40sp" android:background="#88000000" android:visibility="gone"/>
    <GridView android:id="@+id/overlayList" android:layout_width="480dp" android:layout_height="match_parent"
        android:numColumns="3" android:stretchMode="columnWidth" android:horizontalSpacing="4dp"
        android:verticalSpacing="4dp" android:padding="8dp" android:background="#DD000000"
        android:listSelector="#66FFFFFF" android:drawSelectorOnTop="true" android:visibility="gone"/>
</FrameLayout>
