<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-feature android:name="android.software.leanback" android:required="false"/>
    <uses-feature android:name="android.hardware.touchscreen" android:required="false"/>
    <application
        android:label="@string/app_name"
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
        <activity
            android:name=".PlayerActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <!-- Normal launch: resumes the last channel (or channel 1). -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
                <category android:name="android.intent.category.LEANBACK_LAUNCHER"/>
            </intent-filter>
            <!-- Open a channel: action com.example.openiptv.PLAY with extra "number" (int) or "name" (string). -->
            <intent-filter>
                <action android:name="com.example.openiptv.PLAY"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
            <!-- Deep link: openiptv://channel/5  or  openiptv://channel/vtv3 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="openiptv" android:host="channel"/>
            </intent-filter>
        </activity>
    </application>
</manifest>
